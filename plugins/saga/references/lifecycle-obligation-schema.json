{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saga.lifecycle-obligation.v1",
  "title": "Saga lifecycle obligation contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_id",
    "workstream_id",
    "stored_lifecycle_phases",
    "off_chain_obligations",
    "obligations"
  ],
  "properties": {
    "schema": {
      "const": "saga.lifecycle-obligation.v1"
    },
    "contract_id": {
      "$ref": "#/$defs/slug"
    },
    "workstream_id": {
      "$ref": "#/$defs/slug"
    },
    "stored_lifecycle_phases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ideation",
          "brainstorm",
          "plan",
          "review",
          "work",
          "qa"
        ]
      }
    },
    "off_chain_obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "impl-spec",
          "retro"
        ]
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/obligation"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
    },
    "evidenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "minimum_count",
        "independent"
      ],
      "properties": {
        "kind": {
          "enum": [
            "input",
            "lifecycle-state",
            "ceremony-artifact",
            "operator-decision",
            "execution-receipt",
            "canonical-output",
            "check-result",
            "qa-result",
            "review-finding",
            "deliberation-receipt",
            "fallback-receipt",
            "handoff-receipt",
            "github-fact"
          ]
        },
        "minimum_count": {
          "type": "integer",
          "minimum": 1
        },
        "independent": {
          "type": "boolean"
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evidence"
      ],
      "properties": {
        "state": {
          "const": "degraded"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRule"
          }
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "kind",
        "subject",
        "requirement",
        "producer",
        "required_evidence"
      ],
      "properties": {
        "obligation_id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "stored-phase",
            "off-chain-ceremony",
            "gate",
            "artifact",
            "check",
            "quality-assurance",
            "review",
            "deliberation",
            "handoff",
            "external-github"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "requirement": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRule"
          }
        },
        "phase": {
          "enum": [
            "ideation",
            "brainstorm",
            "plan",
            "review",
            "work",
            "qa"
          ]
        },
        "command": {
          "enum": [
            "impl-spec",
            "retro"
          ]
        },
        "fallback": {
          "$ref": "#/$defs/fallback"
        }
      }
    }
  }
}
