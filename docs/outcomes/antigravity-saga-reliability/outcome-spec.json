      "at": "2026-07-30T16:02:41Z",
      "kind": "autonomy-policy",
      "policy": {
        "mode": "autonomous-within-outcome-and-leaf-plan",
        "incidental_fix_limit": 1,
        "targeted_recheck_limit": 1,
        "allowed": [
          "Implement and verify behavior directly required by the active issue and its plan",
          "Fix one defect that directly blocks an acceptance criterion or was caused by the active change",
          "Make a narrow adjacent refactor only when required to implement or test the planned behavior",
          "Address obvious secrets, command execution, path handling, or unsafe input defects on a touched trust boundary",
          "Create leaf branches, commits, pushes, and draft pull requests for the exact active issue",
          "Perform reversible Operations board synchronization through the Outcome coordinator"
        ],
        "approval_required": [
          "A second-order defect or another follow-on workstream",
          "Changes outside the declared repository or plugin boundaries",
          "A new dependency, public contract, architecture, outcome edge, or acceptance criterion",
          "Speculative hardening beyond plausible personal Antigravity harness use",
          "Credential, permission, deployment, destructive data, or production changes",
          "Merging a pull request, deploying, or closing the parent outcome issue",
          "An unresolved product or operator tradeoff"
        ],
        "incidental_findings": "Record and report non-blocking findings without fixing them"
      }
    }
